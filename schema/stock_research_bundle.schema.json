{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ashare-deep-research/stock_research_bundle.schema.json",
  "title": "AShareStockResearchBundle",
  "type": "object",
  "required": ["schema_version", "stock_code", "retrieved_at", "layers"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "stock_code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" },
          "alternative": { "type": ["string", "null"] }
        }
      }
    },
    "layers": {
      "type": "object",
      "required": ["raw", "derived", "ai_analysis"],
      "properties": {
        "raw": {
          "type": "object",
          "required": [
            "company_info",
            "main_business",
            "financials",
            "market_history",
            "market_snapshot"
          ],
          "properties": {
            "company_info": {
              "type": "object",
              "properties": {
                "stock_code": { "type": "string" },
                "stock_name": { "type": "string" },
                "exchange": { "type": "string" },
                "listing_date": { "type": ["string", "null"] },
                "industry": { "type": ["string", "null"] },
                "total_shares": { "type": ["number", "null"] },
                "float_shares": { "type": ["number", "null"] },
                "total_market_cap": { "type": ["number", "null"] },
                "_meta": { "$ref": "#/$defs/meta" }
              }
            },
            "main_business": {
              "type": "object",
              "properties": {
                "stock_code": { "type": "string" },
                "latest_report_date": { "type": ["string", "null"] },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "report_date": { "type": ["string", "null"] },
                      "category_type": { "type": ["string", "null"] },
                      "business_segment": { "type": ["string", "null"] },
                      "revenue": { "type": ["number", "null"] },
                      "revenue_ratio": { "type": ["number", "null"] },
                      "gross_margin": { "type": ["number", "null"] },
                      "_meta": { "$ref": "#/$defs/meta" }
                    }
                  }
                }
              }
            },
            "financials": {
              "type": "object",
              "properties": {
                "income_statement": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "report_date": { "type": ["string", "null"] },
                          "operating_revenue": { "type": ["number", "null"] },
                          "operating_cost": { "type": ["number", "null"] },
                          "operating_profit": { "type": ["number", "null"] },
                          "net_profit_parent": { "type": ["number", "null"] },
                          "gross_profit": { "type": ["number", "null"] },
                          "eps_basic": { "type": ["number", "null"] },
                          "rd_expense": { "type": ["number", "null"] },
                          "selling_expense": { "type": ["number", "null"] },
                          "admin_expense": { "type": ["number", "null"] },
                          "finance_expense": { "type": ["number", "null"] }
                        }
                      }
                    }
                  }
                },
                "balance_sheet": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "report_date": { "type": ["string", "null"] },
                          "total_assets": { "type": ["number", "null"] },
                          "total_liabilities": { "type": ["number", "null"] },
                          "total_equity": { "type": ["number", "null"] },
                          "cash_and_equivalents": { "type": ["number", "null"] },
                          "accounts_receivable": { "type": ["number", "null"] },
                          "inventory": { "type": ["number", "null"] },
                          "goodwill": { "type": ["number", "null"] },
                          "short_term_borrowings": { "type": ["number", "null"] },
                          "long_term_borrowings": { "type": ["number", "null"] }
                        }
                      }
                    }
                  }
                },
                "cash_flow": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "report_date": { "type": ["string", "null"] },
                          "operating_cash_flow": { "type": ["number", "null"] },
                          "investing_cash_flow": { "type": ["number", "null"] },
                          "financing_cash_flow": { "type": ["number", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            },
            "market_history": {
              "type": "object",
              "properties": {
                "adjust": { "type": "string" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": { "type": ["string", "null"] },
                      "open": { "type": ["number", "null"] },
                      "high": { "type": ["number", "null"] },
                      "low": { "type": ["number", "null"] },
                      "close": { "type": ["number", "null"] },
                      "volume": { "type": ["number", "null"] },
                      "amount": { "type": ["number", "null"] }
                    }
                  }
                }
              }
            },
            "market_snapshot": {
              "type": "object",
              "properties": {
                "latest_price": { "type": ["number", "null"] },
                "pe": { "type": ["number", "null"] },
                "pb": { "type": ["number", "null"] },
                "ps": { "type": ["number", "null"] },
                "total_market_cap": { "type": ["number", "null"] },
                "float_market_cap": { "type": ["number", "null"] },
                "turnover_rate": { "type": ["number", "null"] },
                "data_date": { "type": ["string", "null"] }
              }
            }
          }
        },
        "derived": {
          "type": "object",
          "properties": {
            "fundamentals": {
              "type": "object",
              "properties": {
                "latest": {
                  "type": ["object", "null"],
                  "properties": {
                    "report_date": { "type": ["string", "null"] },
                    "revenue_yoy": { "type": ["number", "null"] },
                    "net_profit_yoy": { "type": ["number", "null"] },
                    "gross_margin": { "type": ["number", "null"] },
                    "net_margin": { "type": ["number", "null"] },
                    "roe": { "type": ["number", "null"] },
                    "debt_to_asset_ratio": { "type": ["number", "null"] },
                    "ocf_to_net_profit": { "type": ["number", "null"] }
                  }
                }
              }
            },
            "technicals": {
              "type": "object",
              "properties": {
                "latest": {
                  "type": ["object", "null"],
                  "properties": {
                    "data_date": { "type": ["string", "null"] },
                    "ma5": { "type": ["number", "null"] },
                    "ma20": { "type": ["number", "null"] },
                    "ma60": { "type": ["number", "null"] },
                    "ma250": { "type": ["number", "null"] },
                    "macd_dif": { "type": ["number", "null"] },
                    "macd_dea": { "type": ["number", "null"] },
                    "macd_hist": { "type": ["number", "null"] },
                    "rsi_14": { "type": ["number", "null"] },
                    "high_52w": { "type": ["number", "null"] },
                    "low_52w": { "type": ["number", "null"] },
                    "price_position_in_52w_range": { "type": ["number", "null"] }
                  }
                }
              }
            }
          }
        },
        "ai_analysis": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "note": { "type": "string" },
            "items": { "type": "array" }
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["source", "retrieved_at"],
      "properties": {
        "source": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "data_date": { "type": ["string", "null"] },
        "report_date": { "type": ["string", "null"] }
      }
    }
  },
  "examples": [
    {
